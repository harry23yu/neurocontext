ANTHROPIC_API_KEY=

# Supabase Postgres connection string. Use the "Transaction pooler" connection string
# (Supabase dashboard > Connect > Shared pooler, port 6543), NOT the direct "db.<ref>.supabase.co"
# host — the direct host is IPv6-only and fails to resolve (getaddrinfo ENOTFOUND) on most
# IPv4-only home/school networks.
DATABASE_URL=

# Random 32+ byte secret used to sign session cookies (e.g. `openssl rand -base64 32`)
SESSION_SECRET=

# Resend API key for sending verification code emails
RESEND_API_KEY=

# Verified sender address for Resend (e.g. "NeuroContext <noreply@yourdomain.com>")
EMAIL_FROM=

# Stripe secret key (test mode: sk_test_..., live mode: sk_live_...)
STRIPE_SECRET_KEY=

# Signing secret for the /api/stripe/webhook endpoint (from `stripe listen` or the Dashboard webhook config)
STRIPE_WEBHOOK_SECRET=

# Recurring Price IDs for the paid plans (Stripe Dashboard > Product catalog)
STRIPE_SILVER_PRICE_ID=
STRIPE_GOLD_PRICE_ID=

# Absolute base URL of the app, used for Stripe Checkout/portal redirect URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
